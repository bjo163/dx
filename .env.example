NODE_ENV=development
# false for localhost HTTP development; set true behind HTTPS in production.
COOKIE_SECURE=false
# Generate with: openssl rand -hex 32. Required for the one-time first-owner setup.
DX_BOOTSTRAP_TOKEN=
WEB_PORT=3000
API_PORT=4000
# Keep loopback by default. Set WEB_BIND=0.0.0.0 only for a temporary,
# firewall-restricted direct-IP preview; the initial setup requires DX_BOOTSTRAP_TOKEN.
WEB_BIND=127.0.0.1
API_BIND=127.0.0.1
POSTGRES_PASSWORD=change-this-local-password
API_INTERNAL_URL=http://api:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
REDIS_URL=redis://redis:6379
